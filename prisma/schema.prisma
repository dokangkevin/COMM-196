generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OnboardingState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum EventType {
  INFORMATION_SESSION
  CLUB_EVENT
}

model User {
  id             String          @id @default(cuid())
  externalAuthId String?         @unique
  displayName    String
  email          String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?

  @@index([externalAuthId])
}

model StudentProfile {
  id                      String          @id @default(cuid())
  userId                  String          @unique
  university              String          @default("University of British Columbia")
  faculty                 String
  major                   String
  academicYear            Int
  interests               String[]
  preferredHoursPerWeek   Int?
  onboardingState         OnboardingState @default(NOT_STARTED)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedClubs              SavedClub[]

  @@index([faculty])
  @@index([interests], type: Gin)
}

model Club {
  id                         String                   @id @default(cuid())
  slug                       String                   @unique
  name                       String
  description                String
  mission                    String
  category                   String
  tags                       String[]
  academicRelevance          String[]
  imageRef                   String?
  contactEmail               String?
  socialLinks                Json?
  membershipInformation     String
  expectedHoursPerWeek       Int?
  activities                 String[]
  isRepresentativeDemoData   Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  recruitmentOpportunities   RecruitmentOpportunity[]
  events                     ClubEvent[]
  savedBy                    SavedClub[]

  @@index([category])
  @@index([tags], type: Gin)
  @@index([academicRelevance], type: Gin)
}

model RecruitmentOpportunity {
  id                String            @id @default(cuid())
  clubId            String
  title             String
  description       String
  requirements      String
  applicationOpens  DateTime
  applicationDeadline DateTime
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, publicationStatus])
  @@index([applicationOpens])
  @@index([applicationDeadline])
}

model ClubEvent {
  id          String    @id @default(cuid())
  clubId      String
  title       String
  description String
  eventType   EventType
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, startsAt])
  @@index([eventType, startsAt])
}

model SavedClub {
  studentId String
  clubId    String
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([studentId, clubId])
  @@index([clubId])
}
